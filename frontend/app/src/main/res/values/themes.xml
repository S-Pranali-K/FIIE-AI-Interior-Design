<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light/Default Base Theme -->
    <style name="Theme.FIIE" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Global Window Background & Status Bar -->
        <item name="android:windowBackground">?attr/glassCanvasBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Dynamic Glass Theme Attributes -->
        <item name="glassCanvasBackground">@drawable/bg_glass_orbs_light</item>
        <item name="glassCardBackground">@color/card_bg_light</item>
        <item name="glassCardStroke">@color/card_stroke_light</item>
        <item name="glassInputBackground">@color/input_bg_light</item>
        <item name="glassInputStroke">@color/input_stroke_light</item>
        <item name="glassButtonGradientStart">@color/btn_start_light</item>
        <item name="glassButtonGradientEnd">@color/btn_end_light</item>
        <item name="glassTextColorPrimary">@color/text_primary_light</item>
        <item name="glassTextColorSecondary">@color/text_secondary_light</item>

        <!-- System Text Overrides -->
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        <item name="android:editTextColor">@color/text_primary_light</item>
    </style>
</resources>