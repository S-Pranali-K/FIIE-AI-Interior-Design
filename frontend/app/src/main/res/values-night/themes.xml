<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FIIE" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Dark background -->
        <item name="android:windowBackground">?attr/glassCanvasBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/canvas_dark</item>

        <!-- System bars -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- FIIE glass system -->
        <item name="glassCanvasBackground">@drawable/bg_glass_orbs_dark</item>
        <item name="glassCardBackground">@color/card_bg_dark</item>
        <item name="glassCardStroke">@color/card_stroke_dark</item>

        <item name="glassInputBackground">@color/input_bg_dark</item>
        <item name="glassInputStroke">@color/input_stroke_dark</item>

        <!-- Buttons -->
        <item name="glassButtonGradientStart">@color/btn_start_dark</item>
        <item name="glassButtonGradientEnd">@color/btn_end_dark</item>

        <!-- Text -->
        <item name="glassTextColorPrimary">@color/text_primary_dark</item>
        <item name="glassTextColorSecondary">@color/text_secondary_dark</item>

        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:editTextColor">@color/text_primary_dark</item>

        <!-- Material -->
        <item name="colorPrimary">@color/btn_start_dark</item>
        <item name="colorPrimaryVariant">@color/btn_end_dark</item>
        <item name="colorAccent">@color/fiie_blush</item>
        <item name="colorOnPrimary">@color/text_primary_dark</item>

    </style>

</resources>