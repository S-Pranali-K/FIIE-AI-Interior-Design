<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================================================= -->
    <!-- FIIE WARM IVORY BASE                                      -->
    <!-- ========================================================= -->

    <item>
        <color android:color="@color/canvas_light" />
    </item>


    <!-- ========================================================= -->
    <!-- TOP-LEFT ORGANIC TAUPE GLOW                               -->
    <!-- ========================================================= -->

    <item
        android:top="-180dp"
        android:left="-150dp"
        android:right="110dp"
        android:bottom="420dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
