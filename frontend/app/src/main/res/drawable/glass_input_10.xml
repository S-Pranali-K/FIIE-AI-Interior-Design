<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Soft translucent input surface -->
    <solid android:color="?attr/glassInputBackground" />

    <!-- Thin warm border -->
    <stroke
        android:width="1dp"
        android:color="?attr/glassInputStroke" />

    <!-- Soft rounded input -->
    <corners android:radius="@dimen/fiie_input_radius" />

</shape>