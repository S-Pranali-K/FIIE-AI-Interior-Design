<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_orbs"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/newProjectScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/newProjectBottomSpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/fiie_screen_padding"
            android:paddingTop="24dp"
            android:paddingEnd="@dimen/fiie_screen_padding"
            android:paddingBottom="32dp">

            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_circle"
                    android:contentDescription="Go back"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="?attr/glassTextColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:letterSpacing="0.02"
                        android:text="New Project"
                        android:textColor="?attr/glassTextColorPrimary"
                        android:textSize="@dimen/fiie_heading_2"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Let's understand your space."
                        android:textColor="?attr/glassTextColorSecondary"
                        android:textSize="@dimen/fiie_body" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- INTRO                                             -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="Create a functional space"
                android:textColor="?attr/glassTextColorPrimary"
                android:textSize="@dimen/fiie_heading_1"
                android:fontFamily="serif"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Start by adding a photo of the room you want FIIE to understand and redesign."
                android:textColor="?attr/glassTextColorSecondary"
                android:textSize="@dimen/fiie_body" />


            <!-- ================================================= -->
            <!-- ROOM IMAGE CARD                                   -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardRoomImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/fiie_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card_10"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Small section label -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01  •  ROOM IMAGE"
                        android:textColor="@color/fiie_primary"
                        android:textSize="@dimen/fiie_caption"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <!-- Image preview -->

                    <FrameLayout
                        android:id="@+id/roomImageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="230dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/room_placeholder"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/ivRoomPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="Selected room image"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <!-- Placeholder -->

                        <LinearLayout
                            android:id="@+id/layoutImagePlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_folder"
                                android:tint="@color/fiie_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Add a room photo"
                                android:textColor="?attr/glassTextColorPrimary"
                                android:textSize="@dimen/fiie_body_large"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:gravity="center"
                                android:text="A clear photo helps FIIE understand your space."
                                android:textColor="?attr/glassTextColorSecondary"
                                android:textSize="@dimen/fiie_body_small" />

                        </LinearLayout>

                    </FrameLayout>


                    <!-- Image status -->

                    <TextView
                        android:id="@+id/tvImageStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Add a room image to continue"
                        android:textColor="?attr/glassTextColorSecondary"
                        android:textSize="@dimen/fiie_body_small" />


                    <!-- Select button -->

                    <Button
                        android:id="@+id/btnSelectRoomImage"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fiie_button_height"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/glass_btn_10"
                        android:text="Choose Room Image"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/fiie_button_text"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- NEXT STEP CARD                                    -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardNextStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/fiie_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card_10"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02  •  PROJECT PREFERENCES"
                        android:textColor="@color/fiie_primary"
                        android:textSize="@dimen/fiie_caption"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Tell FIIE what you need"
                        android:textColor="?attr/glassTextColorPrimary"
                        android:textSize="@dimen/fiie_heading_3"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="You'll choose your room type, dimensions, style, colours, materials, budget and other requirements in the next step."
                        android:textColor="?attr/glassTextColorSecondary"
                        android:textSize="@dimen/fiie_body_small" />

                    <Button
                        android:id="@+id/btnContinuePreferences"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fiie_button_height"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/glass_btn_10"
                        android:text="Continue to Preferences"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/fiie_button_text"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- FIIE INTELLIGENCE NOTE                            -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_auto_awesome"
                    android:tint="@color/fiie_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="FIIE will use your inputs to understand the room and generate functionally informed design recommendations."
                    android:textColor="?attr/glassTextColorSecondary"
                    android:textSize="@dimen/fiie_caption" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM SPACING                                           -->
    <!-- ========================================================= -->

    <View
        android:id="@+id/newProjectBottomSpace"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>