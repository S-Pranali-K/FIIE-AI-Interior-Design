<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_orbs"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FIIE"
            android:textColor="#8F7660"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Room Survey"
            android:textColor="#2D2621"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Tell FIIE about your room, preferences and requirements."
            android:textColor="#675C54"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <!-- Progress indicator -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="#8F7660" />

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#D8C9B7" />

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#D8C9B7" />

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#D8C9B7" />

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#D8C9B7" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- A. ROOM DETAILS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/glass_card_10"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  •  ROOM DETAILS"
                android:textColor="#8F7660"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Understand your space"
                android:textColor="#2D2621"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <!-- Room Type -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Room Type"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerRoomType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Dimensions -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Room Size"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etRoomLength"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_input_10"
                    android:hint="Length (ft)"
                    android:inputType="numberDecimal"
                    android:padding="14dp"
                    android:textColor="#2D2621"
                    android:textColorHint="#9A9087"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etRoomWidth"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_input_10"
                    android:hint="Width (ft)"
                    android:inputType="numberDecimal"
                    android:padding="14dp"
                    android:textColor="#2D2621"
                    android:textColorHint="#9A9087"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Ceiling -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ceiling Height"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etCeilingHeight"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:hint="Height (ft)"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:textColor="#2D2621"
                android:textColorHint="#9A9087"
                android:textSize="14sp" />

            <!-- Doors -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Number of Doors"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etDoors"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:hint="e.g. 1"
                android:inputType="number"
                android:padding="14dp"
                android:textColor="#2D2621"
                android:textColorHint="#9A9087"
                android:textSize="14sp" />

            <!-- Windows -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Number of Windows"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etWindows"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:hint="e.g. 2"
                android:inputType="number"
                android:padding="14dp"
                android:textColor="#2D2621"
                android:textColorHint="#9A9087"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- B. EXISTING ROOM -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/glass_card_10"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02  •  EXISTING ROOM"
                android:textColor="#8F7660"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="What is already in the room?"
                android:textColor="#2D2621"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Existing Furniture"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbBed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:buttonTint="#8F7660"
                android:text="Bed"
                android:textColor="#40372F" />

            <CheckBox
                android:id="@+id/cbWardrobe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8F7660"
                android:text="Wardrobe"
                android:textColor="#40372F" />

            <CheckBox
                android:id="@+id/cbStudyTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8F7660"
                android:text="Study Table"
                android:textColor="#40372F" />

            <CheckBox
                android:id="@+id/cbChair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8F7660"
                android:text="Chair"
                android:textColor="#40372F" />

            <CheckBox
                android:id="@+id/cbSofa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8F7660"
                android:text="Sofa"
                android:textColor="#40372F" />

            <CheckBox
                android:id="@+id/cbTvUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8F7660"
                android:text="TV Unit"
                android:textColor="#40372F" />

            <CheckBox
                android:id="@+id/cbOthers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#8F7660"
                android:text="Others"
                android:textColor="#40372F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="What should happen to existing furniture?"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgFurnitureAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbKeepFurniture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#8F7660"
                    android:text="Keep"
                    android:textColor="#40372F" />

                <RadioButton
                    android:id="@+id/rbRepositionFurniture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#8F7660"
                    android:text="Reposition"
                    android:textColor="#40372F" />

                <RadioButton
                    android:id="@+id/rbReplaceFurniture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#8F7660"
                    android:text="Replace"
                    android:textColor="#40372F" />

            </RadioGroup>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- C. DESIGN PREFERENCES -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/glass_card_10"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="03  •  DESIGN PREFERENCES"
                android:textColor="#8F7660"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Shape your design"
                android:textColor="#2D2621"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <!-- Style -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Preferred Style"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Color -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Color Preference"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerColor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Material -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Material Preference"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerMaterial"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Lighting -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Lighting Preference"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerLighting"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Special requirement -->

            <EditText
                android:id="@+id/etSpecialRequirement"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_input_10"
                android:gravity="top"
                android:hint="Special requirements..."
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="#2D2621"
                android:textColorHint="#9A9087"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- D. VASTU -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/glass_card_10"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="04  •  VASTU PREFERENCES"
                android:textColor="#8F7660"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Optional, personalized guidance"
                android:textColor="#2D2621"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <CheckBox
                android:id="@+id/cbEnableVastu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:buttonTint="#8F7660"
                android:text="Enable Vastu-aware recommendations"
                android:textColor="#40372F" />

            <!-- Door -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Main Door Direction"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerDoorDirection"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Bed -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Bed Direction"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerBedDirection"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Kitchen -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Kitchen Direction"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerKitchenDirection"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Pooja -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Pooja / Temple Direction"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerPoojaDirection"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- E. BUDGET -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/glass_card_10"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="05  •  BUDGET"
                android:textColor="#8F7660"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Design within your comfort"
                android:textColor="#2D2621"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <!-- Budget -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Total Budget (₹)"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etBudget"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:hint="e.g. 100000"
                android:inputType="number"
                android:padding="14dp"
                android:textColor="#2D2621"
                android:textColorHint="#9A9087"
                android:textSize="14sp" />

            <!-- Priority -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Budget Priority"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgBudgetPriority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbLowCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#8F7660"
                    android:text="Low Cost"
                    android:textColor="#40372F" />

                <RadioButton
                    android:id="@+id/rbBalanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#8F7660"
                    android:text="Balanced"
                    android:textColor="#40372F" />

                <RadioButton
                    android:id="@+id/rbPremium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#8F7660"
                    android:text="Premium"
                    android:textColor="#40372F" />

            </RadioGroup>

            <!-- Completion -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Expected Completion"
                android:textColor="#675C54"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerCompletion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_input_10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- FINAL ACTION -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="FIIE will use these preferences to understand your space."
            android:textColor="#806F62"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnContinueSurvey"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/glass_btn_10"
            android:text="CONTINUE TO IMAGE ANALYSIS  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>