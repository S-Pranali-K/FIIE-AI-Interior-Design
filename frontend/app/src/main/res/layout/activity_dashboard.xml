<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"


    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F0E9">

    <!-- ================================================= -->
    <!-- BLURRED INTERIOR BACKGROUND -->
    <!-- ================================================= -->

    <ImageView
        android:id="@+id/ivDashboardBackground"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:src="@drawable/bg_dashboard"

        android:scaleType="centerCrop"

        android:contentDescription="@null"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Warm translucent layer -->

    <View
        android:id="@+id/dashboardBackgroundOverlay"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:background="#55F6F0E9"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================================================= -->
    <!-- SOFT BACKGROUND OVERLAY -->
    <!-- ================================================= -->

    <View
        android:id="@+id/backgroundOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#30FFF8F0" />


    <!-- ================================================= -->
    <!-- SCROLLABLE DASHBOARD -->
    <!-- ================================================= -->

    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:clipToPadding="false"

        android:fillViewport="true"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="110dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <!-- Menu -->

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="42dp"
                    android:layout_height="42dp"

                    android:background="@android:color/transparent"

                    android:contentDescription="Menu"

                    android:src="@drawable/ic_menu"

                    app:tint="#4B3D33"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />


                <!-- FIIE -->

                <TextView
                    android:id="@+id/tvDashboardLogo"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="FIIE"

                    android:textColor="#4B3D33"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <!-- Notification -->

                <ImageButton
                    android:id="@+id/btnNotifications"

                    android:layout_width="42dp"
                    android:layout_height="42dp"

                    android:background="@drawable/glass_circle"

                    android:contentDescription="Notifications"

                    android:src="@drawable/ic_notifications"

                    app:tint="#4B3D33"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <!-- Small brand line -->

                <TextView
                    android:id="@+id/tvDashboardBrand"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="AI-POWERED INTERIOR DESIGN"

                    android:textColor="#765A43"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"

                    app:layout_constraintTop_toBottomOf="@id/tvDashboardLogo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ================================================= -->
            <!-- WELCOME -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvDashboardTitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp"

                android:text="Welcome back"

                android:textColor="#2D2621"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="serif" />


            <TextView
                android:id="@+id/tvDashboardSubtitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:text="Let's create a functional and personalized space."

                android:textColor="#675C54"
                android:textSize="15sp"

                android:lineSpacingExtra="2dp" />


            <TextView
                android:id="@+id/tvDashboardIntelligence"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:text="FIIE  •  FUNCTIONAL  •  PERSONALIZED  •  INTELLIGENT"

                android:textColor="#765A43"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />


            <!-- ================================================= -->
            <!-- SEARCH -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/searchBar"

                android:layout_width="match_parent"
                android:layout_height="54dp"

                android:layout_marginTop="20dp"

                android:background="@drawable/glass_dashboard_card"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:paddingStart="16dp"
                android:paddingEnd="16dp">


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"

                    android:contentDescription="Search"

                    android:src="@drawable/ic_search"

                    app:tint="#4B3D33" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="14dp"

                    android:text="What would you like to design today?"

                    android:textColor="#806F61"
                    android:textSize="14sp" />


                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"

                    android:contentDescription="Filter"

                    android:src="@drawable/ic_auto_awesome"

                    app:tint="#765A43" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- START NEW DESIGN HERO -->
            <!-- ================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/glassCardNewDesign"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:background="@drawable/glass_dashboard_card"

                android:elevation="6dp"

                android:padding="22dp">


                <TextView
                    android:id="@+id/tvNewDesignEyebrow"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="FIIE DESIGN STUDIO"

                    android:textColor="#765A43"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />


                <TextView
                    android:id="@+id/tvNewDesignTitle"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Start a New Design"

                    android:textColor="#2D2621"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"

                    app:layout_constraintTop_toBottomOf="@id/tvNewDesignEyebrow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <TextView
                    android:id="@+id/tvNewDesignDescription"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="7dp"

                    android:text="Upload your room, share your requirements, and let FIIE understand your space."

                    android:textColor="#675C54"
                    android:textSize="14sp"

                    android:lineSpacingExtra="3dp"

                    app:layout_constraintTop_toBottomOf="@id/tvNewDesignTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <TextView
                    android:id="@+id/tvNewDesignPipeline"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="13dp"

                    android:text="Room Analysis  •  Functional Intelligence  •  AI Design"

                    android:textColor="#765A43"
                    android:textSize="10sp"
                    android:textStyle="bold"

                    app:layout_constraintTop_toBottomOf="@id/tvNewDesignDescription"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNewDesign"

                    android:layout_width="0dp"
                    android:layout_height="52dp"

                    android:layout_marginTop="18dp"

                    android:background="@drawable/glass_btn_10"

                    android:text="START NEW DESIGN    →"

                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"

                    app:layout_constraintTop_toBottomOf="@id/tvNewDesignPipeline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ================================================= -->
            <!-- QUICK ACTIONS -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvQuickActionsTitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:text="Quick Actions"

                android:textColor="#2D2621"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="serif" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:orientation="horizontal">


                <!-- Projects -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/glassCardProjects"

                    android:layout_width="0dp"
                    android:layout_height="120dp"

                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"

                    android:background="@drawable/glass_dashboard_card"

                    android:padding="14dp">


                    <ImageView
                        android:id="@+id/ivProjectsIcon"

                        android:layout_width="28dp"
                        android:layout_height="28dp"

                        android:src="@drawable/ic_folder"
                        android:contentDescription="Projects"

                        app:tint="#765A43"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <TextView
                        android:id="@+id/tvProjectsTitle"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:text="Projects"

                        android:textColor="#2D2621"
                        android:textSize="14sp"
                        android:textStyle="bold"

                        app:layout_constraintTop_toBottomOf="@id/ivProjectsIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />


                    <TextView
                        android:id="@+id/tvProjectsDescription"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="Your spaces"

                        android:textColor="#806F61"
                        android:textSize="11sp"

                        app:layout_constraintTop_toBottomOf="@id/tvProjectsTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <!-- Analyze -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/glassCardAnalyze"

                    android:layout_width="0dp"
                    android:layout_height="120dp"

                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"

                    android:background="@drawable/glass_dashboard_card"

                    android:padding="14dp">


                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"

                        android:src="@drawable/ic_auto_awesome"
                        android:contentDescription="Analyze"

                        app:tint="#765A43"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <TextView
                        android:id="@+id/tvAnalyzeTitle"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:text="Analyze"

                        android:textColor="#2D2621"
                        android:textSize="14sp"
                        android:textStyle="bold"

                        app:layout_constraintTop_toBottomOf="@id/glassCardAnalyze"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <!-- Saved -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/glassCardSaved"

                    android:layout_width="0dp"
                    android:layout_height="120dp"

                    android:layout_weight="1"
                    android:layout_marginStart="6dp"

                    android:background="@drawable/glass_dashboard_card"

                    android:padding="14dp">


                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"

                        android:src="@drawable/ic_auto_awesome"
                        android:contentDescription="Saved"

                        app:tint="#765A43"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <TextView
                        android:id="@+id/tvSavedTitle"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:text="Saved"

                        android:textColor="#2D2621"
                        android:textSize="14sp"
                        android:textStyle="bold"

                        app:layout_constraintTop_toBottomOf="@id/glassCardSaved"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- RECENT PROJECTS -->
            <!-- ================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/recentProjectsCard"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:background="@drawable/glass_dashboard_card"

                android:padding="20dp">


                <TextView
                    android:id="@+id/tvRecentProjectsTitle"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Recent Projects"

                    android:textColor="#2D2621"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />


                <TextView
                    android:id="@+id/tvRecentProjectsSeeAll"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="View All  →"

                    android:textColor="#765A43"
                    android:textSize="12sp"
                    android:textStyle="bold"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <TextView
                    android:id="@+id/tvRecentProjects"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:text="Your recent designs will appear here."

                    android:textColor="#806F61"
                    android:textSize="13sp"

                    app:layout_constraintTop_toBottomOf="@id/tvRecentProjectsTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ================================================= -->
            <!-- FIIE INTELLIGENCE -->
            <!-- ================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardHowFiiEWorks"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:background="@drawable/glass_dashboard_card"

                android:padding="20dp">


                <TextView
                    android:id="@+id/tvHowFiiEWorks"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="How FIIE Thinks"

                    android:textColor="#2D2621"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />


                <TextView
                    android:id="@+id/tvCapabilityAnalysis"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp"

                    android:text="01   Room Analysis     Understand your space"

                    android:textColor="#675C54"
                    android:textSize="12sp"

                    app:layout_constraintTop_toBottomOf="@id/tvHowFiiEWorks"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <TextView
                    android:id="@+id/tvCapabilityFunctional"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="9dp"

                    android:text="02   Functional Intelligence     Improve usability"

                    android:textColor="#675C54"
                    android:textSize="12sp"

                    app:layout_constraintTop_toBottomOf="@id/tvCapabilityAnalysis"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <TextView
                    android:id="@+id/tvCapabilityPersonalized"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="9dp"

                    android:text="03   Personalized Design     Match your lifestyle"

                    android:textColor="#675C54"
                    android:textSize="12sp"

                    app:layout_constraintTop_toBottomOf="@id/tvCapabilityFunctional"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <TextView
                    android:id="@+id/tvCapabilityBudget"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="9dp"

                    android:text="04   Budget Intelligence     Design within priorities"

                    android:textColor="#675C54"
                    android:textSize="12sp"

                    app:layout_constraintTop_toBottomOf="@id/tvCapabilityPersonalized"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <TextView
                    android:id="@+id/tvCapabilityRecommendations"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="9dp"

                    android:text="05   Recommendations     Explain every decision"

                    android:textColor="#675C54"
                    android:textSize="12sp"

                    app:layout_constraintTop_toBottomOf="@id/tvCapabilityBudget"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"

        android:layout_width="match_parent"
        android:layout_height="78dp"

        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"

        android:background="@drawable/bottom_nav_glass"

        android:elevation="12dp"

        android:gravity="center"
        android:orientation="horizontal"

        android:paddingStart="6dp"
        android:paddingEnd="6dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- HOME -->

        <LinearLayout
            android:id="@+id/navHome"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"

                android:src="@drawable/ic_home"
                android:contentDescription="Home"

                app:tint="#765A43" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Home"

                android:textColor="#765A43"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ANALYZE -->

        <LinearLayout
            android:id="@+id/navAnalyze"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"

                android:src="@drawable/ic_auto_awesome"
                android:contentDescription="Analyze"

                app:tint="#4B3D33" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Analyze"

                android:textColor="#675C54"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- CREATE -->

        <LinearLayout
            android:id="@+id/navCreate"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">


            <TextView
                android:id="@+id/tvCreateCircle"

                android:layout_width="52dp"
                android:layout_height="52dp"

                android:background="@drawable/glass_btn_10"

                android:gravity="center"

                android:text="+"

                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="normal" />

        </LinearLayout>


        <!-- SAVED -->

        <LinearLayout
            android:id="@+id/navSaved"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"

                android:src="@drawable/ic_auto_awesome"
                android:contentDescription="Saved"

                app:tint="#4B3D33" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Saved"

                android:textColor="#675C54"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/navProfile"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"

                android:src="@drawable/ic_person"
                android:contentDescription="Profile"

                app:tint="#4B3D33" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Profile"

                android:textColor="#675C54"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>