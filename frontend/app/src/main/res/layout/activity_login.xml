<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/bg_splash">


    <!-- Dark transparent overlay for readability -->

    <View
        android:id="@+id/backgroundOverlay"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:background="#35FFF8F0" />


    <!-- FIIE brand -->

    <TextView
        android:id="@+id/tvLoginLogo"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="34dp"

        android:text="FIIE"
        android:textColor="#4B3D33"
        android:textSize="42sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.08"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Small brand descriptor -->

    <TextView
        android:id="@+id/tvBrandDescriptor"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="5dp"

        android:text="AI-POWERED FUNCTIONAL INTERIOR DESIGN"
        android:textColor="#765A43"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.10"

        app:layout_constraintTop_toBottomOf="@id/tvLoginLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Main glass login card -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/glassCard"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="28dp"

        android:background="@drawable/glass_login_card"

        android:elevation="10dp"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="28dp"

        app:layout_constraintTop_toBottomOf="@id/tvBrandDescriptor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- Welcome -->

        <TextView
            android:id="@+id/tvWelcome"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Welcome Back"
            android:textColor="#2D2621"
            android:textSize="27sp"
            android:textStyle="bold"
            android:fontFamily="serif"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Subtitle -->

        <TextView
            android:id="@+id/tvLoginSubtitle"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:gravity="center"

            android:text="Login to continue your FIIE journey."
            android:textColor="#675C54"
            android:textSize="14sp"

            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Email -->

        <EditText
            android:id="@+id/etEmail"

            android:layout_width="0dp"
            android:layout_height="56dp"

            android:layout_marginTop="28dp"

            android:background="@drawable/glass_input_10"

            android:hint="Email or Mobile Number"

            android:inputType="textEmailAddress"

            android:paddingStart="18dp"
            android:paddingEnd="18dp"

            android:textColor="#2D2621"
            android:textColorHint="#806F61"

            android:textSize="15sp"

            android:singleLine="true"

            app:layout_constraintTop_toBottomOf="@id/tvLoginSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Password -->

        <EditText
            android:id="@+id/etPassword"

            android:layout_width="0dp"
            android:layout_height="56dp"

            android:layout_marginTop="14dp"

            android:background="@drawable/glass_input_10"

            android:hint="Password"

            android:inputType="textPassword"

            android:paddingStart="18dp"
            android:paddingEnd="18dp"

            android:textColor="#2D2621"
            android:textColorHint="#806F61"

            android:textSize="15sp"

            android:singleLine="true"

            app:layout_constraintTop_toBottomOf="@id/etEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Forgot password -->

        <TextView
            android:id="@+id/tvForgotPassword"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:text="Forgot Password?"
            android:textColor="#765A43"
            android:textSize="13sp"
            android:textStyle="bold"

            android:clickable="true"
            android:focusable="true"

            app:layout_constraintTop_toBottomOf="@id/etPassword"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Login button -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"

            android:layout_width="0dp"
            android:layout_height="54dp"

            android:layout_marginTop="20dp"

            android:background="@drawable/glass_btn_10"

            android:text="LOGIN    →"

            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"

            android:letterSpacing="0.04"

            app:layout_constraintTop_toBottomOf="@id/tvForgotPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Divider -->

        <LinearLayout
            android:id="@+id/loginDivider"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            android:gravity="center"
            android:orientation="horizontal"

            app:layout_constraintTop_toBottomOf="@id/btnLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#B9AA9C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"

                android:text="OR"
                android:textColor="#806F61"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#B9AA9C" />

        </LinearLayout>


        <!-- Register -->

        <TextView
            android:id="@+id/tvRegister"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            android:text="Don't have an account?  Register"

            android:textColor="#675C54"
            android:textSize="14sp"

            android:clickable="true"
            android:focusable="true"

            app:layout_constraintTop_toBottomOf="@id/loginDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Bottom identity -->

    <TextView
        android:id="@+id/tvLoginFooter"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginBottom="22dp"

        android:text="FUNCTIONAL  •  PERSONALIZED  •  INTELLIGENT"

        android:textColor="#806F61"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>