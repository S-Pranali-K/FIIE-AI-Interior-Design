<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/glassCanvasBackground">

    <!-- Header -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/glass_circle"
        android:contentDescription="Back"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="?attr/glassTextColorPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSettingsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="FIIE"
        android:textAllCaps="true"
        android:textColor="?attr/glassTextColorPrimary"
        android:textSize="12sp"
        android:letterSpacing="0.16"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <!-- Page title -->

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="30dp"
        android:text="Settings"
        android:textColor="?attr/glassTextColorPrimary"
        android:textSize="32sp"
        android:fontFamily="sans-serif"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvSettingsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="6dp"
        android:text="Personalize your FIIE experience."
        android:textColor="?attr/glassTextColorSecondary"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle" />

    <!-- Appearance card -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAppearance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="?attr/glassCardBackground"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textColor="?attr/glassTextColorPrimary"
                android:textSize="21sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Choose how FIIE should look."
                android:textColor="?attr/glassTextColorSecondary"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rgTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <RadioButton
                    android:id="@+id/rbSystem"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="System Default"
                    android:textColor="?attr/glassTextColorPrimary"
                    android:textSize="16sp"
                    android:buttonTint="?attr/colorAccent" />

                <RadioButton
                    android:id="@+id/rbLight"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Light"
                    android:textColor="?attr/glassTextColorPrimary"
                    android:textSize="16sp"
                    android:buttonTint="?attr/colorAccent" />

                <RadioButton
                    android:id="@+id/rbDark"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Dark"
                    android:textColor="?attr/glassTextColorPrimary"
                    android:textSize="16sp"
                    android:buttonTint="?attr/colorAccent" />

            </RadioGroup>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- FIIE note -->

    <TextView
        android:id="@+id/tvThemeNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        android:text="Your appearance preference is saved automatically."
        android:textColor="?attr/glassTextColorSecondary"
        android:textSize="13sp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardAppearance" />

</androidx.constraintlayout.widget.ConstraintLayout>