<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/bg_glass_orbs"

    android:padding="20dp">


    <!-- ========================================= -->
    <!-- TOP BRANDING -->
    <!-- ========================================= -->

    <LinearLayout
        android:id="@+id/fiieHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvFiieLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FIIE"
            android:textColor="?attr/colorOnBackground"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:text="FUNCTIONAL INTERIOR INTELLIGENCE"
            android:textColor="?attr/colorPrimary"
            android:textSize="8sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================================= -->
    <!-- BACK BUTTON -->
    <!-- ========================================= -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"

        android:background="@drawable/glass_circle"

        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"

        app:tint="?attr/colorOnBackground"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ========================================= -->
    <!-- CENTRAL GLASS ANALYSIS CARD -->
    <!-- ========================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/glassCardAnalysis"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:background="@drawable/glass_card_10"

        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <!-- ================================= -->
        <!-- AI ICON -->
        <!-- ================================= -->

        <FrameLayout
            android:id="@+id/analysisIconContainer"
            android:layout_width="76dp"
            android:layout_height="76dp"

            android:background="@drawable/glass_circle"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgAnalysisIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"

                android:src="@drawable/ic_auto_awesome"
                android:contentDescription="AI Analysis"

                app:tint="?attr/colorPrimary" />

        </FrameLayout>


        <!-- ================================= -->
        <!-- TITLE -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/tvAnalysisTitle"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            android:letterSpacing="0.03"
            android:text="AI Analysis"

            android:textColor="?attr/colorOnBackground"
            android:textSize="29sp"
            android:textStyle="bold"

            app:layout_constraintTop_toBottomOf="@id/analysisIconContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================= -->
        <!-- MESSAGE -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/tvAnalysisMessage"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:text="Analyzing your room..."
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"

            android:gravity="center"

            app:layout_constraintTop_toBottomOf="@id/tvAnalysisTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================= -->
        <!-- ANALYSIS DETAILS -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/tvAnalysisDetail"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="Understanding space, furniture, lighting and functionality"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"

            android:gravity="center"

            android:alpha="0.85"

            app:layout_constraintTop_toBottomOf="@id/tvAnalysisMessage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================= -->
        <!-- PROGRESS BAR -->
        <!-- ================================= -->

        <ProgressBar
            android:id="@+id/progressAnalysis"

            style="?android:attr/progressBarStyleHorizontal"

            android:layout_width="0dp"
            android:layout_height="8dp"

            android:layout_marginTop="30dp"

            android:max="100"
            android:progress="0"

            android:progressTint="@color/fiie_primary"
            android:progressBackgroundTint="@color/fiie_progress_track"

            android:indeterminate="false"

            app:layout_constraintTop_toBottomOf="@id/tvAnalysisDetail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================= -->
        <!-- PROGRESS PERCENTAGE -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/tvProgress"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:text="0%"
            android:textColor="?attr/colorOnBackground"
            android:textSize="17sp"
            android:textStyle="bold"

            app:layout_constraintTop_toBottomOf="@id/progressAnalysis"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================= -->
        <!-- PROCESSING STATUS -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/tvProcessingStatus"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:text="FIIE AI is working..."
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"

            app:layout_constraintTop_toBottomOf="@id/tvProgress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================================= -->
    <!-- FOOTER -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/tvFiieFooter"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="FIIE • Functional Interior Intelligence"
        android:textColor="?attr/colorOnSurface"
        android:textSize="10sp"

        android:alpha="0.7"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>