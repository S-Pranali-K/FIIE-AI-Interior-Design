<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5F0">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvPreferencesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Design Preferences"
                android:textColor="#2F3E35"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreferencesSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tell us how you want your space to look and function."
                android:textColor="#777777"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvRoomTypeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Room Type"
                android:textColor="#2F3E35"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerRoomType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvStyleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Preferred Design Style"
                android:textColor="#2F3E35"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvBudgetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Budget Range"
                android:textColor="#2F3E35"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerBudget"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvFunctionalLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Functional Requirements"
                android:textColor="#2F3E35"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFunctionalRequirements"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:hint="Example: More storage, better lighting, study area..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:backgroundTint="#2F3E35" />

            <TextView
                android:id="@+id/tvVastuLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Vastu Guidance"
                android:textColor="#2F3E35"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchVastu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Include optional Vastu-based suggestions"
                android:textColor="#555555"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGenerateDesign"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#2F3E35"
                android:text="GENERATE DESIGN"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>